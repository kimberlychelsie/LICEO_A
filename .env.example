# Copy to .env and fill in values. Do not commit .env.

# App
SECRET_KEY=your-long-random-secret-key-here
FLASK_ENV=development

# Authenticated sessions: 24-hour absolute lifetime and 5-minute inactivity timeout.
AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=86400
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=300
AUTH_SESSION_RETENTION_DAYS=7
AUTH_SESSION_CLEANUP_BATCH_SIZE=1000
AUTH_SESSION_CLEANUP_MAX_BATCHES=100

# Database (used by the app: db.py)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=liceo_db
DB_USER=liceo_db
DB_PASSWORD=your-db-password

# Keep false through the nullable-column migration and audited backfill.
# Enable only after year_id coverage has been verified for this environment.
TEACHER_ANNOUNCEMENTS_STRICT_YEAR=false

# Enable only after all payment-first reservation migrations are validated.
RESERVATION_PAYMENT_FIRST_ENABLED=false

# Optional: single connection string (for scripts and some deploys e.g. Railway)
# Railway sets DATABASE_URL automatically; for local scripts you can set it instead of DB_*.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Production (Railway sets these)
# RAILWAY_ENVIRONMENT=production

# Optional: Redis for Flask-Limiter (shared limits across Gunicorn workers). Railway Redis sets REDIS_URL.
# REDIS_URL=redis://default:password@host:6379
# Or override explicitly:
# RATELIMIT_STORAGE_URI=redis://...

# Optional: Gunicorn worker request timeout in seconds (OCR / large uploads). Dockerfile / Procfile default 600.
# GUNICORN_TIMEOUT=600
